# Bridge server configuration
# Copy this file to .env and adjust values.
# `npm run start:bridge` and `npm run sim` auto-load .env
# (via node --env-file-if-exists), so the token stays in sync automatically.

# Port for the bridge/API server
PORT=3001

# Shared secret the ESP32 must present when registering.
# REQUIRED in production (NODE_ENV=production) - the bridge refuses to start
# without it. In development it is optional: if unset, the bridge generates a
# random token and logs it at startup (pass that to the simulator/firmware).
# Keep in sync with DEVICE_TOKEN in firmware/esp32_led/esp32_led.ino
DEVICE_AUTH_TOKEN=change-me-to-a-long-random-string

# CORS origin of the frontend (Vercel URL in production, * for local dev)
ALLOWED_ORIGIN=*
