# Bridge server configuration
# Copy this file to .env and adjust values

# Port for the bridge/API server
PORT=3001

# Shared secret the ESP32 must present when registering.
# Keep in sync with DEVICE_TOKEN in firmware/esp32_led/esp32_led.ino
DEVICE_AUTH_TOKEN=bharati-dev-token

# CORS origin of the frontend (Vercel URL in production, * for local dev)
ALLOWED_ORIGIN=*
